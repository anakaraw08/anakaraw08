# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your settings stay on your computer.

# Where the pipeline loads data: sqlite or sqlserver
LOAD_TARGET=sqlite

# SQL Server connection (only used when LOAD_TARGET=sqlserver)
SQL_SERVER=YOUR-PC\SQLEXPRESS
SQL_DATABASE=ShopETL
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Leave blank to use Windows Authentication
SQL_USER=
SQL_PASSWORD=
